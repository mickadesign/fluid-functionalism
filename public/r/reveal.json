{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "reveal",
  "title": "Reveal",
  "description": "Page reveals in 1 class, on the existing spring tiers: slow for landing, moderate for product. .reveal-landing for a page read once: the hero rises and scales in on load, later sections do on scroll, and every section leaves the same way at the top; .reveal-scroll makes a deeper element, like a grid card, a section of its own. .reveal-product for the app: blocks fade in on load, nothing on scroll. Each has a -subtle step. For slow data, .reveal-swap crossfades shadcn's Skeleton into the real block and .reveal-items brings rows in one by one. Pure CSS; reduced motion keeps the fades and drops the rest.",
  "registryDependencies": [
    "skeleton"
  ],
  "css": {
    "@keyframes reveal-preset": {
      "from": {
        "opacity": "0",
        "transform": "translateY(var(--reveal-distance, 0px)) scale(var(--reveal-scale, 1))"
      }
    },
    ".reveal-landing": {
      "--reveal-motion": "250ms linear(0, 0.3878, 0.7777, 0.9458, 0.9946, 1.0029, 1.0021, 1)",
      "--reveal-distance": "12px",
      "--reveal-scale": "0.94",
      "--reveal-step": "0.1s",
      "--reveal-scroll-start": "12px",
      "--reveal-scroll": "120px"
    },
    ".reveal-landing-subtle": {
      "--reveal-motion": "250ms linear(0, 0.3878, 0.7777, 0.9458, 0.9946, 1.0029, 1.0021, 1)",
      "--reveal-distance": "8px",
      "--reveal-scale": "0.98",
      "--reveal-step": "0.06s",
      "--reveal-scroll-start": "8px",
      "--reveal-scroll": "60px"
    },
    ".reveal-product": {
      "--reveal-motion": "200ms linear(0, 0.5729, 0.8966, 0.9789, 0.996, 1, 1)",
      "--reveal-step": "0.06s"
    },
    ".reveal-product-subtle": {
      "--reveal-motion": "200ms linear(0, 0.5729, 0.8966, 0.9789, 0.996, 1, 1)",
      "--reveal-step": "0.04s"
    },
    ":is(.reveal-landing, .reveal-landing-subtle) > :first-child > *, :is(.reveal-product, .reveal-product-subtle) > *, .reveal-items > *, .reveal-swap > :last-child:not(:first-child)": {
      "animation": "reveal-preset var(--reveal-motion, 200ms linear(0, 0.5729, 0.8966, 0.9789, 0.996, 1, 1)) both"
    },
    ":is(.reveal-landing, .reveal-landing-subtle) > :first-child > :nth-child(2), :is(.reveal-product, .reveal-product-subtle) > :nth-child(2)": {
      "animation-delay": "var(--reveal-step)"
    },
    ":is(.reveal-landing, .reveal-landing-subtle) > :first-child > :nth-child(3), :is(.reveal-product, .reveal-product-subtle) > :nth-child(3)": {
      "animation-delay": "calc(var(--reveal-step) * 2)"
    },
    ":is(.reveal-landing, .reveal-landing-subtle) > :first-child > :nth-child(n + 4), :is(.reveal-product, .reveal-product-subtle) > :nth-child(n + 4)": {
      "animation-delay": "calc(var(--reveal-step) * 3)"
    },
    ":is(.reveal-product, .reveal-product-subtle) > .reveal-items": {
      "animation": "none"
    },
    ".reveal-items > :nth-child(2)": {
      "animation-delay": "calc(var(--reveal-step, 0.06s) * 1)"
    },
    ".reveal-items > :nth-child(3)": {
      "animation-delay": "calc(var(--reveal-step, 0.06s) * 2)"
    },
    ".reveal-items > :nth-child(4)": {
      "animation-delay": "calc(var(--reveal-step, 0.06s) * 3)"
    },
    ".reveal-items > :nth-child(5)": {
      "animation-delay": "calc(var(--reveal-step, 0.06s) * 4)"
    },
    ".reveal-items > :nth-child(6)": {
      "animation-delay": "calc(var(--reveal-step, 0.06s) * 5)"
    },
    ".reveal-items > :nth-child(7)": {
      "animation-delay": "calc(var(--reveal-step, 0.06s) * 6)"
    },
    ".reveal-items > :nth-child(n + 8)": {
      "animation-delay": "calc(var(--reveal-step, 0.06s) * 7)"
    },
    "@keyframes reveal-out": {
      "to": {
        "opacity": "0"
      }
    },
    ".reveal-swap": {
      "display": "grid"
    },
    ".reveal-swap > *": {
      "grid-area": "1 / 1",
      "min-width": "0"
    },
    ".reveal-swap > :first-child:not(:last-child)": {
      "pointer-events": "none",
      "animation": "reveal-out var(--reveal-motion, 200ms linear(0, 0.5729, 0.8966, 0.9789, 0.996, 1, 1)) forwards"
    },
    ".reveal-swap > .reveal-items:not(:only-child)": {
      "animation": "none"
    },
    ".reveal-swap > .reveal-items:first-child:not(:last-child) > *": {
      "animation-name": "reveal-out",
      "animation-fill-mode": "forwards"
    },
    "@keyframes reveal-skeleton-in": {
      "from": {
        "opacity": "0"
      }
    },
    "@keyframes reveal-pulse": {
      "50%": {
        "opacity": "0.5"
      }
    },
    ":is(.reveal-product, .reveal-product-subtle, .reveal-items, .reveal-swap) [data-slot=\"skeleton\"]": {
      "animation": "reveal-skeleton-in 250ms ease-in-out both, reveal-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) 250ms infinite"
    },
    ".reveal-swap > :first-child:not(:last-child) [data-slot=\"skeleton\"]": {
      "animation": "none"
    },
    "@keyframes reveal-leave": {
      "to": {
        "opacity": "0",
        "transform": "translateY(calc(var(--reveal-distance, 0px) * -1)) scale(var(--reveal-scale, 1))"
      }
    },
    "@supports (animation-timeline: view())": {
      ":is(.reveal-landing, .reveal-landing-subtle) > :first-child": {
        "animation": "reveal-leave 1ms linear both",
        "animation-timeline": "view()",
        "animation-range": "exit calc(100% - var(--reveal-scroll)) exit calc(100% - var(--reveal-scroll-start))"
      },
      ":is(.reveal-landing, .reveal-landing-subtle) > :not(:first-child), :is(.reveal-landing, .reveal-landing-subtle) .reveal-scroll": {
        "--reveal-load-delay": "calc(var(--reveal-step) * 4)",
        "animation": "reveal-preset 1ms linear both, reveal-leave 1ms linear both, reveal-preset var(--reveal-motion, 200ms linear(0, 0.5729, 0.8966, 0.9789, 0.996, 1, 1)) backwards",
        "animation-timeline": "view(), view(), auto",
        "animation-range": "entry var(--reveal-scroll-start) entry var(--reveal-scroll), exit calc(100% - var(--reveal-scroll)) exit calc(100% - var(--reveal-scroll-start)), normal",
        "animation-delay": "0s, 0s, var(--reveal-load-delay)"
      },
      ":is(.reveal-landing, .reveal-landing-subtle) .reveal-scroll:nth-child(2)": {
        "--reveal-load-delay": "calc(var(--reveal-step) * 5)"
      },
      ":is(.reveal-landing, .reveal-landing-subtle) .reveal-scroll:nth-child(3)": {
        "--reveal-load-delay": "calc(var(--reveal-step) * 6)"
      },
      ":is(.reveal-landing, .reveal-landing-subtle) .reveal-scroll:nth-child(n + 4)": {
        "--reveal-load-delay": "calc(var(--reveal-step) * 7)"
      },
      ":is(.reveal-landing, .reveal-landing-subtle) > :not(:first-child):has(.reveal-scroll)": {
        "animation": "none"
      },
      ":is(.reveal-landing, .reveal-landing-subtle) .reveal-scroll .reveal-scroll": {
        "--reveal-load-delay": "inherit",
        "animation-range": "entry calc(var(--reveal-scroll-start) + var(--reveal-scroll) / 2) entry calc(var(--reveal-scroll) * 1.5), exit calc(100% - var(--reveal-scroll) * 1.5) exit calc(100% - var(--reveal-scroll-start) - var(--reveal-scroll) / 2), normal",
        "animation-delay": "0s, 0s, calc(var(--reveal-load-delay) + var(--reveal-step))"
      }
    },
    "@media (prefers-reduced-motion: reduce)": {
      ":is(.reveal-landing, .reveal-landing-subtle)": {
        "--reveal-distance": "0px",
        "--reveal-scale": "1"
      },
      ":is(.reveal-landing, .reveal-landing-subtle) > :first-child, :is(.reveal-landing, .reveal-landing-subtle) > :not(:first-child):has(.reveal-scroll)": {
        "animation": "none"
      },
      ":is(.reveal-landing, .reveal-landing-subtle) > :not(:first-child), :is(.reveal-landing, .reveal-landing-subtle) .reveal-scroll": {
        "animation": "reveal-preset var(--reveal-motion, 200ms linear(0, 0.5729, 0.8966, 0.9789, 0.996, 1, 1)) backwards",
        "animation-delay": "var(--reveal-load-delay, 0s)"
      },
      ":is(.reveal-landing, .reveal-landing-subtle) .reveal-scroll .reveal-scroll": {
        "animation-delay": "calc(var(--reveal-load-delay, 0s) + var(--reveal-step))"
      },
      ":is(.reveal-product, .reveal-product-subtle, .reveal-items, .reveal-swap) [data-slot=\"skeleton\"]": {
        "animation": "reveal-skeleton-in 250ms ease-in-out both"
      }
    }
  },
  "docs": "Docs & live playground: https://www.fluidfunctionalism.com/docs/reveal. Craft notes, the color, layout and motion decisions to keep when you change it: https://github.com/mickadesign/fluid-functionalism/blob/main/skills/fluid-functionalism/references/craft.md#reveal.",
  "categories": [
    "theme"
  ],
  "type": "registry:item"
}
