{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "icons-fluid",
  "title": "Fluid Icon Set",
  "description": "Fluid glyphs for every icon slot the components look up, with corners that follow the radius (sharp, rounded or pill). Pass the map to IconProvider (or FluidProvider's icons prop) and every component draws Fluid.",
  "registryDependencies": [
    "https://www.fluidfunctionalism.com/r/icon-context.json",
    "https://www.fluidfunctionalism.com/r/shape-context.json"
  ],
  "files": [
    {
      "path": "registry/default/lib/icons-fluid.tsx",
      "content": "\"use client\";\n\n// ---------------------------------------------------------------------------\n// Fluid icons for every slot the components look up (see icon-context).\n// Pass the map to IconProvider and every component draws them:\n//\n//   <IconProvider icons={fluidIcons}>{children}</IconProvider>\n//\n// Corners follow the Radius setting (shape-context): Sharp draws sharp\n// corners and flat ends, Rounded a little round, Pill rounder still. The\n// stroke follows strokeWidth like any other set.\n//\n// These 68 icons are the free core of Fluid Icons. The full set,\n// and a skill that draws new icons in the same style, are at\n// https://icons.fluidfunctionalism.com\n//\n// Generated from the icon set's source. Edit there, not here.\n// ---------------------------------------------------------------------------\n\nimport { useId } from \"react\";\n\nimport type { IconComponent, IconName } from \"@/lib/icon-context\";\nimport { useShape, type ShapeVariant } from \"@/lib/shape-context\";\n\ntype Layer = { m: string; o?: 1 };\ntype Glyph = { s?: Layer[]; b: Layer[]; r?: Layer[] };\n\nconst CORNERS: Record<ShapeVariant, \"s\" | \"b\" | \"r\"> = { sharp: \"s\", rounded: \"b\", pill: \"r\" };\nconst CAPS = {\n  s: { strokeLinecap: \"butt\", strokeLinejoin: \"miter\" },\n  b: { strokeLinecap: \"round\", strokeLinejoin: \"round\" },\n  r: { strokeLinecap: \"round\", strokeLinejoin: \"round\" },\n} as const;\n/** Clear space an upper layer knocks out of the ones under it, in strokes. */\nconst CUT = 5;\n\nconst GLYPHS: Record<IconName, Glyph> = {\n  \"chevron-right\": {\"b\":[{\"m\":\"<path d=\\\"M9 6l6 6-6 6\\\"/>\"}],\"s\":[{\"m\":\"<path d=\\\"M8.47 5.47L9 6L15 12L9 18L8.47 18.53\\\"/>\"}],\"r\":[{\"m\":\"<path d=\\\"M9 6L15 12L9 18\\\"/>\"}]},\n  \"chevron-down\": {\"b\":[{\"m\":\"<path d=\\\"M6 9l6 6 6-6\\\"/>\"}],\"s\":[{\"m\":\"<path d=\\\"M5.47 8.47L6 9L12 15L18 9L18.53 8.47\\\"/>\"}],\"r\":[{\"m\":\"<path d=\\\"M6 9L12 15L18 9\\\"/>\"}]},\n  \"pipette\": {\"b\":[{\"m\":\"<path d=\\\"M10.5 6.5l7 7\\\"/><path d=\\\"M2 22s4.5-.5 7-3L21 7a2.83 2.83 0 1 0-4-4L5 15c-2.5 2.5-3 7-3 7z\\\"/>\"}],\"s\":[{\"m\":\"<path d=\\\"M9.97 5.97L10.5 6.5L17.5 13.5L18.03 14.03\\\"/><path d=\\\"M9 19L21 7A2.83 2.83 0 1 0 17 3L5 15C2.5 17.5 2 22 2 22C2 22 6.5 21.5 9 19Z\\\"/>\"}],\"r\":[{\"m\":\"<path d=\\\"M10.5 6.5L17.5 13.5\\\"/><path d=\\\"M9 19L21 7A2.83 2.83 0 1 0 17 3L5 15C2.5 17.5 2 22 2 22C2 22 6.5 21.5 9 19Z\\\"/>\"}]},\n  \"x\": {\"b\":[{\"m\":\"<path d=\\\"M6 6l12 12M18 6L6 18\\\"/>\"}],\"s\":[{\"m\":\"<path d=\\\"M5.47 5.47L6 6L18 18L18.53 18.53M18.53 5.47L18 6L6 18L5.47 18.53\\\"/>\"}],\"r\":[{\"m\":\"<path d=\\\"M6 6L18 18M18 6L6 18\\\"/>\"}]},\n  \"copy\": {\"b\":[{\"m\":\"<rect x=\\\"8\\\" y=\\\"8\\\" width=\\\"13\\\" height=\\\"13\\\" rx=\\\"3\\\"/><path d=\\\"M16 8V6a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3v7a3 3 0 0 0 3 3h2\\\"/>\"}],\"s\":[{\"m\":\"<rect x=\\\"8\\\" y=\\\"8\\\" width=\\\"13\\\" height=\\\"13\\\" rx=\\\"0\\\"/><path d=\\\"M16 8.75L16 8L16 3L3 3L3 16L8 16L8.75 16\\\"/>\"}],\"r\":[{\"m\":\"<rect x=\\\"8\\\" y=\\\"8\\\" width=\\\"13\\\" height=\\\"13\\\" rx=\\\"4.5\\\"/><path d=\\\"M16 8L16 7A4 4 0 0 0 12 3L7.5 3A4.5 4.5 0 0 0 3 7.5L3 12A4 4 0 0 0 7 16L8 16\\\"/>\"}]},\n  \"menu\": {\"b\":[{\"m\":\"<path d=\\\"M3 6h18M3 12h18M3 18h18\\\"/>\"}],\"s\":[{\"m\":\"<path d=\\\"M2.25 6L3 6L21 6L21.75 6M2.25 12L3 12L21 12L21.75 12M2.25 18L3 18L21 18L21.75 18\\\"/>\"}],\"r\":[{\"m\":\"<path d=\\\"M3 6L21 6M3 12L21 12M3 18L21 18\\\"/>\"}]},\n  \"dot\": {\"b\":[{\"m\":\"<circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\"/>\"}]},\n  \"monitor\": {\"b\":[{\"m\":\"<rect x=\\\"2\\\" y=\\\"3\\\" width=\\\"20\\\" height=\\\"13.5\\\" rx=\\\"3\\\"/><path d=\\\"M8 21h8M12 16.5v4.5\\\"/>\"}],\"s\":[{\"m\":\"<rect x=\\\"2\\\" y=\\\"3\\\" width=\\\"20\\\" height=\\\"13.5\\\" rx=\\\"0\\\"/><path d=\\\"M7.25 21L8 21L16 21L16.75 21M12 15.75L12 16.5L12 21\\\"/>\"}],\"r\":[{\"m\":\"<rect x=\\\"2\\\" y=\\\"3\\\" width=\\\"20\\\" heig