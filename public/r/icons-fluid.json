  ))}\n              </mask>\n              <g mask={`url(#${id}-${i})`} dangerouslySetInnerHTML={{ __html: m }} />\n            </g>\n          );\n        })}\n      </svg>\n    );\n  };\n}\n\nexport const fluidIcons = Object.fromEntries(\n  Object.entries(GLYPHS).map(([name, glyph]) => [name, makeIcon(glyph)]),\n) as Record<IconName, IconComponent>;\n",
